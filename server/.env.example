# Server Port
PORT=5000

# Allowed Frontend Origin for CORS (e.g. your local frontend server)
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your real MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/expense_tracker?retryWrites=true&w=majority

# Secret key used for signing and verifying JSON Web Tokens (JWT)
JWT_SECRET=mySecretJwtKey_ChangeThisForProduction_2026
